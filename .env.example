# ===== Backend =====
# Base de datos. En desarrollo: SQLite. En producción: URL de Neon/Supabase (postgresql+psycopg://...)
DATABASE_URL=sqlite:///./worldradio.db
# Orígenes permitidos por CORS, separados por comas (el dominio del frontend)
CORS_ORIGINS=http://localhost:5173
# Token secreto SOLO para POST /api/admin/sync (genera uno largo y aleatorio)
ADMIN_SYNC_TOKEN=cambia-esto-por-un-token-largo
# User-Agent enviado a Radio Browser
RADIO_BROWSER_USER_AGENT=WorldRadio/1.0 (https://github.com/tu-usuario/worldradio)
# Límite de peticiones por IP (formato slowapi)
RATE_LIMIT=120/minute
ENVIRONMENT=development

# ===== Frontend =====
# URL pública del backend (se incrusta en el build; no es un secreto)
VITE_API_URL=http://localhost:8000
